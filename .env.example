# Copy this file to .env before running the stack.

COMPOSE_PROJECT_NAME=onehouse

# Apache Kafka broker (KRaft mode, apache/kafka:3.7.0)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ONEHOUSE_KAFKA_TOPIC=telecom.raw_logs
SIMULATOR_EVENTS_PER_SECOND=20
SIMULATOR_DUPLICATE_RATIO=0.01
SIMULATOR_BAD_RECORD_RATIO=0.005

# Object storage and Iceberg warehouse
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_WAREHOUSE_BUCKET=warehouse
AWS_REGION=us-east-1

# Spark Cluster
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
ICEBERG_CATALOG=

# PostgreSQL Billing (CDC)
POSTGRES_BILLING_USER=
POSTGRES_BILLING_PASSWORD=
POSTGRES_BILLING_DB=

# Trino/dbt
TRINO_USER=admin
TRINO_HOST=trino
TRINO_PORT=8080

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Superset
SUPERSET_SECRET_KEY=change-me-in-real-deployments
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_TRINO_URI=trino://admin@trino:8080//gold
